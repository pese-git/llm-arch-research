      "checkpoint_dir": "checkpoints/llama-corpus",
      "save_interval": 200,
      "seed": 0,
      "train_log_path": "checkpoints/llama-corpus/log.json"
    },
    "log_path": "checkpoints/llama_corpus_training_logs.json"
